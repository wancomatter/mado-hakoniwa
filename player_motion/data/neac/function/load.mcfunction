data modify storage neac: DimensionGenerated set value 0b
execute store success storage neac: DimensionGenerated byte 1 in neac: run time query gametime
execute unless data storage neac: {DimensionGenerated:1b} run tellraw @a {"text":"補助ディメンション neac: を読み込むためにワールドを再起動してください。","color":"red"}
execute if data storage neac: {DimensionGenerated:1b} in neac: run forceload add -1 -1 1 1
